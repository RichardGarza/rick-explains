# Everything is optional. With no keys, the app runs free and local:
# Ollama writes the script and Kokoro does the voice.

# --- Script writer ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b          # default: best installed model
# Or pay for Claude instead (sharper scripts):
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Voice ---
# KOKORO_VOICE=am_fenrir            # see the dropdown on the page for options
# KOKORO_SPEED=1.15
# Or a paid voice API. ElevenLabs wins if both are set.
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_MODEL=eleven_multilingual_v2
OPENAI_API_KEY=
# OPENAI_VOICE=ash

# PORT=3000
